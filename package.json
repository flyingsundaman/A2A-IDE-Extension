{
  "name": "antigravity-a2a-mesh",
  "displayName": "A2A Workspace",
  "description": "Configure agents, connect providers and MCP tools, manage knowledge, and track multi-agent work.",
  "version": "2.0.0",
  "publisher": "local-mesh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:a2a.squadView"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "a2a-sidebar",
          "title": "A2A",
          "icon": "resources/wordmark.svg"
        }
      ]
    },
    "views": {
      "a2a-sidebar": [
        {
          "type": "webview",
          "id": "a2a.squadView",
          "name": "A2A Workspace"
        }
      ]
    },
    "commands": [
      {
        "command": "a2a.openSquad",
        "title": "Open Workspace",
        "category": "A2A"
      },
      {
        "command": "a2a.askClaude",
        "title": "Consult Agent with Selection",
        "category": "A2A"
      },
      {
        "command": "a2a.auditCodex",
        "title": "Review Selection",
        "category": "A2A"
      },
      {
        "command": "a2a.runCouncil",
        "title": "Open Tasks",
        "category": "A2A"
      },
      {
        "command": "a2a.syncObsidian",
        "title": "Open Knowledge & Skills",
        "category": "A2A"
      },
      {
        "command": "a2a.refreshQuotas",
        "title": "Test Connections",
        "category": "A2A"
      },
      {
        "command": "a2a.openAgents",
        "title": "Open Agents & Connections",
        "category": "A2A"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "a2a.askClaude",
          "group": "a2a_group@1"
        },
        {
          "command": "a2a.auditCodex",
          "group": "a2a_group@2"
        },
        {
          "command": "a2a.runCouncil",
          "group": "a2a_group@3"
        }
      ],
      "commandPalette": [
        {
          "command": "a2a.openSquad"
        },
        {
          "command": "a2a.askClaude"
        },
        {
          "command": "a2a.auditCodex"
        },
        {
          "command": "a2a.runCouncil"
        },
        {
          "command": "a2a.syncObsidian"
        },
        {
          "command": "a2a.refreshQuotas"
        }
      ]
    },
    "configuration": {
      "title": "A2A",
      "properties": {}
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:ui": "node test/ui.cjs"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Configuration can be viewed. Agent execution, connection checks and connector processes require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "playwright": "1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingsundaman/A2A-IDE-Extension.git"
  },
  "license": "UNLICENSED"
}
